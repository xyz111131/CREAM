                "--out_variant",
                "Rscripts/results/simulated_data/novel_variants_unique_test_fold0.csv",
                "--out_carrier",
                "Rscripts/results/simulated_data/novel_variant_carriers_test_fold0.csv",
            ]
        },
    ]
