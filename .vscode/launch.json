    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: eval GTEX with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "CREAM/test_gtex.py",
            "console": "integratedTerminal",
            "args": [
                "--config_path",
                "configs/blood_config0-4-shift-diff.yaml",
                "--fold",
                "1",
                "--model_type",
                "MultiGene",
                "--runid",
                "c92158vx",
            ]
        },
        {
            "name": "Python Debugger: train GTEX with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "CREAM/train_gtex2.py",
            "console": "integratedTerminal",
            "args": [
                "--config_path",
                "CREAM/configs/blood_config_test0.yaml",
                "--fold",
                "0",
                "--model_type",
                "MultiGene",
                "--num_gpus",
                "1",
            ]
        },
        {
            "name": "Python Debugger: train GTEX test run with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "CREAM/train_gtex2.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--config_path",
                "CREAM/configs/blood_config_test_run2.yaml",
                "--fold",
                "0",
                "--model_type",
                "MultiGene",
                "--num_gpus",
                "1",
                "--use_test_data",
            ]
        },
        {
            "name": "Python Debugger: ISM genes CREAM with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "CREAM/ism_cream0.py",
            "console": "integratedTerminal",
            "args": [
                "--path_to_metadata",
                "CREAM/wandb/run-20250525_094514-gl9h617j/files/config.yaml",
                "--path_to_genes_file",
                "data/genes/good_train_genes.txt", 
                "--model_type",
                "MultiGene",
            ]
        },
        {
            "name": "Python Debugger: ISM variants CREAM with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "CREAM/ism_cream.py",
            "console": "integratedTerminal",
            "args": [
                "--path_to_metadata",
                "CREAM/wandb/run-20250419_144530-1s4gqfj7/files/config.yaml",
                "--path_to_variants_file",
                "data/rare_variants_folds/select_genotype-fold1.txt",
                "--model_type",
                "MultiGene",
            ]
        },
        {
            "name": "Python Debugger: variant wash-out demo",
            "type": "debugpy",
            "request": "launch",
            "program": "CREAM/demo_variant_washout.py",
            "console": "integratedTerminal",
            "args": [
                "--intervals",
                "data/Gencode.v46.TSSCentered_49K_Intervals.csv",
                "--n-intervals",
                "5",
                "--random-anchor",
            ]
        },
        {
            "name": "Python Debugger: variant proximity demo",
            "type": "debugpy",
            "request": "launch",
            "program": "CREAM/demo_variant_proximity.py",
            "console": "integratedTerminal",
            "args": [
                "--intervals",
                "data/Gencode.v46.TSSCentered_49K_Intervals.csv",
                "--n-intervals",
                "5",
                "--random-anchor",
            ]
        },
        {
            "name": "Python Debugger: novel variants (de novo SNVs)",
            "type": "debugpy",
            "request": "launch",
            "program": "Rscripts/novel_variants.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--genes",
                "data/genes/MultiGene/egenes/train_filter_egenes_5K.txt",
